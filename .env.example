# Database Connection (SQLite default for zero-setup local dev; change to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Regulatory Intelligence Hub India"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration ("local-rule-grounded" requires zero external API keys)
# Set to "gemini" or "openai" when API keys are available
AI_PROVIDER="local-rule-grounded"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Security & Crawl Configuration
CRAWLER_USER_AGENT="RegulatoryIntelligenceHubBot/1.0 (+https://regulatoryintelligencehub.in/bot; compliance-research)"
MAX_INGESTION_FILE_SIZE_MB=25
AUTH_SECRET="dev-secret-regulatory-intelligence-hub-india-2024"
